    "@tanstack/react-start": "^1.168.48",
    "@tanstack/router-plugin": "^1.168.34",
    "jose": "^6.2.2",
    "papaparse": "^5.4.1",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "tailwindcss": "^4.2.4"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@types/papaparse": "^5.3.14",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
