{
  "name": "brain2",
  "private": true,
  "type": "module",
  "scripts": {
    "build:client": "node scripts/build-client.mjs",
    "dev": "pnpm run build:client && cf dev",
    "dev:wrangler": "pnpm run build:client && node scripts/dev-wrangler.mjs",
    "deploy": "pnpm run build:client && cf deploy",
    "dryrun": "pnpm run build:client && cf deploy --dry-run",
    "typegen": "cf workers types",
    "check": "pnpm run build:client && tsc --noEmit",
    "test": "pnpm run build:client && vitest run",
    "format": "prettier --write src tests scripts cloudflare.config.ts tsconfig.json package.json README.md AGENTS.md",
    "test:agent": "node --experimental-strip-types scripts/evaluate-agent.mjs"
  },
  "dependencies": {
    "@earendil-works/chord": "~1.4.0",
    "@earendil-works/pi-ai": "~1.4.0",
    "@earendil-works/pi-durable": "~1.4.0",
    "agents": "^0.32.0",
    "markdown-it": "^15.0.3",
    "preact": "^10.27.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "latest",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^26.6.6",
    "cf": "1.0.0-rc.2",
    "esbuild": "0.28.2",
    "miniflare": "5.20261019.1-beta",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5",
    "wrangler": "^4.165.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.24.0",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": "26.13.1",
      "onFail": "download"
    }
  }
}
