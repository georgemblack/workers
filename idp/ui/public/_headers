# Headers for the static pages, which are served without running the worker.
# The worker adds the same headers to its own responses in src/index.ts.
#
# Content-Security-Policy:
#   - Only load scripts, styles, images and API calls from this site, so
#     injected code won't run.
#   - frame-ancestors: stop other sites from showing these pages inside a
#     frame (clickjacking).
# X-Content-Type-Options: stop browsers guessing a file's type.
/*
  Content-Security-Policy: default-src 'self'; base-uri 'none'; object-src 'none'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
