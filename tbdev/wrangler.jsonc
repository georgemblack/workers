{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tbdev",
  "main": "src/index.ts",
  "account_id": "bc4564dd499c0a9b8a7bb79c9bd5ea6d",
  "compatibility_date": "2026-07-03",
  "observability": {
    "enabled": true,
  },
  "workers_dev": true,
  "assets": {
    "binding": "ASSETS",
    "directory": "./public",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none",
  },
  "vars": {
    "TBDEV_ENV": "test",
  },
  "ai": {
    "binding": "AI",
  },
  "browser": {
    "binding": "BROWSER",
  },
  "analytics_engine_datasets": [
    {
      "binding": "ANALYTICS",
      "dataset": "tbdev_analytics",
    },
  ],
  "version_metadata": {
    "binding": "VERSION_METADATA",
  },
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 100,
        "period": 60,
      },
    },
  ],
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "4e4803a65cd9417ea08920d8b7cca69b",
    },
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tbdev",
      "database_id": "69975128-9bf7-4bc3-a9e7-acb8b40f05f7",
      "remote": true,
    },
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "tbdev-bucket",
    },
  ],
  "vectorize": [
    {
      "binding": "VECTORIZE",
      "index_name": "tbdev-vectorize",
    },
  ],
  "queues": {
    "producers": [
      {
        "binding": "QUEUE",
        "queue": "tbdev-queue",
      },
    ],
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "DO",
        "class_name": "TbdevDurableObject",
        "script_name": "tbdev-do",
      },
      {
        "name": "SQLITE_DO",
        "class_name": "TbdevSqliteDurableObject",
        "script_name": "tbdev-do",
      },
    ],
  },
  "workflows": [
    {
      "binding": "WORKFLOW",
      "name": "tbdev-workflow",
      "class_name": "TbdevWorkflow",
      "script_name": "tbdev-workflow",
    },
  ],
  "services": [
    {
      "binding": "RPC",
      "service": "tbdev-rpc",
    },
  ],
  "tail_consumers": [
    {
      "service": "tbdev-tail",
    },
  ],
  "mtls_certificates": [
    {
      "binding": "MTLS_CERT",
      "certificate_id": "7cfe856b-1421-451b-a85e-651947fa2155",
    },
  ],
  "secrets_store_secrets": [
    {
      "binding": "SECRET",
      "store_id": "7a396974a7624558b2be43191bbd9fe6",
      "secret_name": "tbdev",
    },
  ],
  "send_email": [
    {
      "name": "SEND_EMAIL",
    },
  ],
}
